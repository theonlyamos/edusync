# ===========================================
# Supabase Configuration
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===========================================
# AI models
# ===========================================
# Platform admins pick every model on /admin/ai-models. The *_MODEL vars and
# AI_PROVIDER below are only used for settings left blank there.
# A chat provider (GEMINI, CEREBRAS, GROQ, OPENAI) can be picked for text or
# visuals once its <NAME>_API_KEY and <NAME>_BASE_URL are set. Nothing fails
# over to another provider automatically.

# OpenAI: only used if OpenAI is picked as the text or visuals provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# ===========================================
# Google Gemini Configuration
# ===========================================
GEMINI_API_KEY=
GEMINI_BASE_URL=
# Fallback voice tutor model (admin AI models page wins). GEMINI_LIVE_MODEL
# (below) wins over this old public name when both are set.
NEXT_PUBLIC_GEMINI_LIVE_MODEL=
# Minutes of voice time charged up front per block (1-10, default 5).
# The browser reconnects to renew shortly before each block ends.
VOICE_BILLING_BLOCK_MINUTES=
# Fallback models (admin AI models page wins, then these, then defaults in code)
# GEMINI_MODEL: text and visuals on Gemini (default gemini-2.5-flash)
GEMINI_MODEL=
GEMINI_IMAGE_MODEL=
GEMINI_EXTRACTION_MODEL=
GEMINI_EMBEDDING_MODEL=

# ===========================================
# Stripe Configuration
# ===========================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CREDIT_PRODUCT_ID=
STRIPE_CREDIT_PRICE_ID=

# ===========================================
# Email (Resend) - invite and password-reset emails don't send until both are set
# ===========================================
RESEND_API_KEY=
EMAIL_FROM="InsyteAI <invites@your-domain.com>"
# Who gets an email for each new Help & feedback request (comma-separated).
# Leave empty to email every active platform admin.
SUPPORT_NOTIFY_EMAIL=
# Support address shown on the public Support, Privacy and Terms pages (optional)
NEXT_PUBLIC_SUPPORT_EMAIL=

# ===========================================
# Tavily Search API (Optional)
# ===========================================
TAVILY_API_KEY=

# ===========================================
# Helicone Observability (Optional)
# ===========================================
HELICONE_BASE_URL=
HELICONE_API_KEY=

# ===========================================
# Application Settings
# ===========================================
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Base URL used in invite and password-reset email links (falls back to the request's origin)
APP_URL=
NEXT_PUBLIC_APP_URL=
# Fallback visuals provider when none is picked on the admin AI models page
AI_PROVIDER=GEMINI
# Maximum session-generated artifacts per objective and learning run (default 6).
STUDENT_FALLBACK_PER_OBJECTIVE_LIMIT=6
# Embed API key (isk_*) used by the public /demo page. Leave empty to disable the demo.
# NOTE: NEXT_PUBLIC_ vars ship in the client bundle - use a dedicated, rate-limited key.
NEXT_PUBLIC_DEMO_EMBED_API_KEY=

# ===========================================
# Live classes (LiveKit + agent worker)
# ===========================================
LIVEKIT_URL=wss://your-project.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Registered LiveKit agent name (must match deployed workers). When set, the app dispatches that agent into live-class rooms on create (and via explicit dispatch if the room already exists).
LIVEKIT_AGENT_NAME=
# Optional; defaults to LIVEKIT_API_SECRET for WebhookReceiver
LIVEKIT_WEBHOOK_SECRET=
# Minutes before scheduled_start_at that join is allowed (default 15)
LIVE_CLASS_LOBBY_MINUTES=15
# Optional; match LIVE_CLASS_LOBBY_MINUTES so the Join button enables at the same time as the server (default 15)
NEXT_PUBLIC_LIVE_CLASS_LOBBY_MINUTES=15
# Shared secret for POST /api/live-classes/agent/persist-visualization (agent worker only)
LIVE_CLASS_AGENT_SECRET=
# Base URL the agent uses to call Next.js (e.g. https://app.example.com)
LIVE_CLASS_APP_BASE_URL=http://localhost:3000
# Agent: Google Gemini Live (see LiveKit Google plugin docs)
GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=
# The co-teacher asks the app for the model and voice picked on the admin AI
# models page at the start of each class. If none is set there (or the app
# can't be reached), it uses GEMINI_LIVE_MODEL, then GOOGLE_LIVE_MODEL, then
# gemini-3.8-live; and GEMINI_VOICE, then Zephyr.
GOOGLE_LIVE_MODEL=
GEMINI_VOICE=
